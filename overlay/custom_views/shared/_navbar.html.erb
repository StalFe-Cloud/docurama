<div class="pt-4 pb-2 px-4 max-w-6xl mx-auto">
  <div class="navbar navbar-glass px-4 py-2.5 flex items-center justify-between transition-all">
    <div class="flex items-center space-x-3">
      <a href="<%= root_path %>" class="flex items-center space-x-3 group">
        <%= render 'shared/logo', class: 'w-8 h-8 md:w-9 md:h-9 transition-transform group-hover:scale-105' %>
        <div class="flex flex-col">
          <span class="text-xl md:text-2xl font-bold tracking-tight text-[#0F172A] leading-tight">
            Docu<span class="text-[#1D72FE]">rama</span>
          </span>
          <span class="text-[8px] md:text-[9px] uppercase tracking-widest text-[#64748B] font-semibold">
            DOCUMENTS • SIGNED • SIMPLIFIED
          </span>
        </div>
      </a>
    </div>

    <% if signed_in? %>
      <div class="hidden md:flex items-center space-x-1 bg-[#F1F5F9] p-1 rounded-xl border border-[#E2E8F0]">
        <a href="<%= root_path %>" class="nav-link-pill <%= 'active' if controller_name == 'templates_dashboard' || controller_name == 'dashboard' %>">
          <%= t('templates') %>
        </a>
        <a href="<%= submissions_path %>" class="nav-link-pill <%= 'active' if controller_name == 'submissions_dashboard' || controller_name == 'submissions' %>">
          <%= t('submissions') %>
        </a>
        <a href="<%= settings_account_path %>" class="nav-link-pill <%= 'active' if params[:controller].to_s.start_with?('settings') || params[:controller].to_s.include?('settings') %>">
          <%= t('settings') %>
        </a>
      </div>

      <div class="flex items-center space-x-3">
        <%= render 'shared/navbar_buttons' %>
        
        <div class="dropdown dropdown-end">
          <label tabindex="0" class="btn btn-ghost btn-circle avatar cursor-pointer ring-2 ring-[#E2E8F0] hover:ring-[#1D72FE] transition-all">
            <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-[#1D72FE] to-[#6366F1] flex items-center justify-center text-white font-bold text-sm shadow-sm">
              <%= current_user.email.first.upcase %>
            </div>
          </label>
          <ul tabindex="0" class="mt-3 z-[50] p-2 shadow-xl menu menu-compact dropdown-content bg-white rounded-2xl w-60 border border-[#E2E8F0]">
            <li class="px-3 py-2 border-b border-[#F1F5F9] mb-1">
              <span class="text-xs font-semibold text-[#64748B] uppercase tracking-wider block"><%= current_account.name %></span>
              <span class="text-sm font-medium text-[#0F172A] truncate block"><%= current_user.email %></span>
            </li>
            <li>
              <a href="<%= settings_account_path %>" class="rounded-lg py-2 text-sm font-medium text-[#334155] hover:bg-[#F8FAFC] hover:text-[#0F172A]">
                <%= svg_icon('settings', class: 'w-4 h-4 text-[#64748B]') %>
                <%= t('settings') %>
              </a>
            </li>
            <li>
              <a href="<%= settings_profile_index_path %>" class="rounded-lg py-2 text-sm font-medium text-[#334155] hover:bg-[#F8FAFC] hover:text-[#0F172A]">
                <%= svg_icon('user', class: 'w-4 h-4 text-[#64748B]') %>
                <%= t('profile') %>
              </a>
            </li>
            <li class="border-t border-[#F1F5F9] mt-1 pt-1">
              <%= button_to destroy_user_session_path, method: :delete, class: 'rounded-lg py-2 text-sm font-medium text-red-600 hover:bg-red-50 w-full text-left flex items-center space-x-2' do %>
                <%= svg_icon('logout', class: 'w-4 h-4 text-red-500') %>
                <span><%= t('sign_out') %></span>
              <% end %>
            </li>
          </ul>
        </div>
      </div>
    <% else %>
      <div class="flex items-center space-x-3">
        <a href="<%= new_user_session_path %>" class="btn btn-sm btn-ghost font-semibold text-[#334155] hover:text-[#0F172A]">
          <%= t('sign_in') %>
        </a>
      </div>
    <% end %>
  </div>
</div>
