<%= content_for(:canonical_url, new_user_session_url) %>
<div class="min-h-[80vh] flex items-center justify-center px-4 py-12 relative overflow-hidden">
  <!-- Ambient background glow -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-[#1D72FE]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-[#6366F1]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="w-full max-w-md bg-white rounded-3xl p-8 md:p-10 border border-[#E2E8F0] shadow-xl relative z-10">
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center mb-4">
        <%= render 'shared/logo', class: 'w-12 h-12' %>
      </div>
      <h1 class="text-3xl font-extrabold text-[#0F172A] tracking-tight">
        Docu<span class="text-[#1D72FE]">rama</span>
      </h1>
      <p class="text-xs uppercase tracking-widest text-[#64748B] font-semibold mt-1">
        DOCUMENTS • SIGNED • SIMPLIFIED
      </p>
      <h2 class="text-lg font-semibold text-[#334155] mt-4"><%= t('sign_in') %></h2>
    </div>

    <%= form_for(resource, as: resource_name, html: { class: 'space-y-5' }, data: { turbo: params[:redir].blank? }, url: session_path(resource_name)) do |f| %>
      <%= render 'hidden_fields' %>
      <div class="space-y-4" dir="auto">
        <div class="form-control">
          <%= f.label :email, t(:email), class: 'block text-xs font-semibold text-[#475569] uppercase tracking-wider mb-1.5' %>
          <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'base-input w-full h-11 px-3.5', placeholder: 'name@company.com' %>
        </div>
        <div class="form-control">
          <div class="flex justify-between items-center mb-1.5">
            <%= f.label :password, t(:password), class: 'block text-xs font-semibold text-[#475569] uppercase tracking-wider' %>
            <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
              <%= link_to t('forgot_your_password_'), new_password_path(resource_name), class: 'text-xs text-[#1D72FE] hover:underline font-medium' %>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: 'current-password', class: 'base-input w-full h-11 px-3.5', placeholder: '••••••••' %>
        </div>
      </div>
      
      <div class="pt-2">
        <%= f.button button_title(title: t(:sign_in), disabled_with: t(:signing_in)), class: 'btn btn-primary w-full h-11 font-semibold text-base shadow-md' %>
      </div>
    <% end %>

    <div class="mt-6 text-center text-xs text-[#94A3B8]">
      Protected by enterprise-grade cryptographic signatures
    </div>
  </div>
</div>
