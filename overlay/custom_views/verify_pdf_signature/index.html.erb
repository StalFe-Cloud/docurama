<div class="min-h-screen bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-slate-100 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center gap-3 mb-4">
        <img src="/logo.svg" alt="Docurama" class="w-10 h-10 rounded-xl shadow-lg" onerror="this.src='/favicon.svg'">
        <span class="text-2xl font-black tracking-tight text-white">Docurama</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-bold uppercase tracking-wider mb-3">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Digital Trust &amp; Cryptographic Verification
      </div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight sm:text-4xl">
        Document Verification Portal
      </h1>
      <p class="mt-3 text-sm text-slate-400 max-w-xl mx-auto">
        Verify the legal authenticity, RFC 3161 timestamps, and cryptographic integrity of any document signed on Docurama.
      </p>
    </div>

    <% if @is_verified && @submission %>
      <!-- Verified Certificate Card -->
      <div class="bg-slate-900/80 backdrop-blur-xl border border-emerald-500/30 rounded-3xl p-6 sm:p-8 mb-8 shadow-2xl shadow-emerald-950/30 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex items-start justify-between flex-wrap gap-4 border-b border-slate-800 pb-6 mb-6">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shadow-inner">
              <%= svg_icon('shield_check', class: 'w-7 h-7') %>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h2 class="text-lg font-bold text-white">Cryptographically Certified Document</h2>
                <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 uppercase">
                  <%= @completed ? 'Sealed & Certified' : 'Active Signature Flow' %>
                </span>
              </div>
              <p class="text-xs text-slate-400 mt-0.5">Envelope ID: <span class="font-mono text-slate-300"><%= @submission.id %></span></p>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs text-slate-500 block">RFC 3161 Timestamp Authority</span>
            <span class="text-xs font-semibold text-indigo-400">DigiCert Global Root CA</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 text-xs">
          <div class="p-4 rounded-2xl bg-slate-800/40 border border-slate-800">
            <span class="text-slate-500 block mb-1">Document Title</span>
            <span class="text-sm font-semibold text-white"><%= @submission.name.presence || @template&.name.presence || 'Document' %></span>
          </div>
          <div class="p-4 rounded-2xl bg-slate-800/40 border border-slate-800">
            <span class="text-slate-500 block mb-1">SHA-256 Tamper Digest</span>
            <span class="font-mono text-slate-300 truncate block text-[11px]"><%= @digest %></span>
          </div>
        </div>

        <div class="space-y-3 mb-6">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Participant Signers &amp; Audit Trail</span>
          <% @submitters.each do |s| %>
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-800/30 border border-slate-800/80">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-full bg-gradient-to-tr from-indigo-500 to-violet-500 text-white font-bold text-xs flex items-center justify-center">
                  <%= (s.name.presence || s.email).first.upcase %>
                </span>
                <div>
                  <span class="text-xs font-bold text-white block"><%= s.name.presence || s.email %></span>
                  <span class="text-[11px] text-slate-500 font-mono"><%= s.email %></span>
                </div>
              </div>
              <div class="text-right">
                <% if s.completed_at %>
                  <span class="inline-flex items-center gap-1 text-emerald-400 text-xs font-semibold">
                    <%= svg_icon('circle_check', class: 'w-3.5 h-3.5') %>
                    Signed
                  </span>
                  <span class="text-[10px] text-slate-500 block font-mono"><%= l(s.completed_at, format: :short) rescue s.completed_at.to_s %></span>
                <% else %>
                  <span class="text-amber-400 text-xs font-semibold">Pending</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="p-4 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-xs text-indigo-300 flex items-center gap-3">
          <%= svg_icon('certificate', class: 'w-5 h-5 text-indigo-400 shrink-0') %>
          <span>This audit certificate is cryptographically immutable and verified against the Docurama Trust Registry.</span>
        </div>
      </div>
    <% end %>

    <!-- Drag and drop PDF verification -->
    <div class="bg-slate-900/60 backdrop-blur-xl border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl">
      <div class="text-center mb-6">
        <h2 class="text-lg font-bold text-white mb-1">Verify Signed PDF File</h2>
        <p class="text-xs text-slate-400">Upload any PDF with digital signatures or timestamps to inspect certificate chains.</p>
      </div>

      <%= form_for '', url: verify_pdf_signature_index_path, method: :post, html: { enctype: 'multipart/form-data', class: 'block' } do %>
        <file-dropzone data-submit-on-upload="true" class="w-full block">
          <label for="verify_file_input" class="w-full block h-44 relative rounded-2xl border-2 border-dashed border-slate-700 hover:border-indigo-500 bg-slate-800/30 hover:bg-indigo-500/5 transition-all duration-300 cursor-pointer group flex items-center justify-center p-6 text-center">
            <div>
              <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
                <%= svg_icon('cloud_upload', class: 'w-6 h-6') %>
              </div>
              <span class="text-sm font-bold text-white block mb-1">Click to browse or drop signed PDF here</span>
              <span class="text-xs text-slate-500">Supports PDF/A, RFC 3161 TSA, PKCS#7, and X.509 certificates</span>
            </div>
            <input id="verify_file_input" name="files[]" class="hidden" type="file" accept="application/pdf" data-action="change:file-dropzone#onSelectFiles" data-target="file-dropzone.input">
          </label>
        </file-dropzone>
      <% end %>

      <div id="result" class="mt-6"></div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-10 text-xs text-slate-600">
      <a href="/" class="text-indigo-400 hover:text-indigo-300 font-semibold transition-colors">Return to Docurama Home</a>
      <span class="mx-2">&bull;</span>
      <span>Docurama Digital Trust Engine</span>
    </div>
  </div>
</div>
