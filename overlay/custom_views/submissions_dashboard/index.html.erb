<% filter_params = params.permit(Submissions::Filter::ALLOWED_PARAMS).compact_blank %>
<% is_show_tabs = (@pagy.count.nil? || @pagy.count >= 5) || params[:status].present? || filter_params.present? %>
<% if Docuseal.demo? %><%= render 'shared/demo_alert' %><% end %>
<div class="group/header flex justify-between items-center w-full mb-6">
  <div class="flex items-center flex-grow min-w-0 max-md:group-has-[search-input:focus-within]/header:hidden <%= 'max-md:hidden' if params[:q].present? %>">
    <div class="mr-3">
      <%= render 'dashboard/toggle_view', selected: 'submissions' %>
    </div>
    <h1 class="text-2xl md:text-3xl font-bold truncate tracking-tight text-[#0F172A] <%= 'hidden' if params[:q].present? %>">
      <%= t('submissions') %>
    </h1>
  </div>
  <div class="flex space-x-2 max-md:has-[search-input:focus-within]:grow <%= 'max-md:grow' if params[:q].present? %>">
    <% if params[:q].present? || @pagy.pages > 1 || filter_params.present? %>
      <%= render 'shared/search_input' %>
    <% end %>
    <% if can?(:create, ::Template) %>
      <open-modal-mobile data-disabled="<%= !Docuseal.multitenant? %>" class="flex">
        <%= link_to new_template_path, class: 'btn btn-primary gap-2 shadow-sm', data: { turbo_frame: :modal } do %>
          <%= svg_icon('plus', class: 'w-5 h-5 stroke-2') %>
          <span class="hidden md:block font-semibold"><%= t('create') %></span>
        <% end %>
      </open-modal-mobile>
    <% end %>
  </div>
</div>

<% view_archived_html = capture do %>
  <% if can?(:manage, :countless) || current_account.submissions.where.not(archived_at: nil).exists? %>
    <div>
      <a href="<%= submissions_archived_index_path %>" class="link text-sm text-[#64748B] hover:text-[#1D72FE]"><%= t('view_archived') %></a>
    </div>
  <% end %>
<% end %>

<% if is_show_tabs %>
  <div class="flex items-center flex-col md:flex-row md:flex-wrap gap-2 mb-6">
    <div class="flex items-center space-x-1 bg-[#F1F5F9] p-1 rounded-xl border border-[#E2E8F0]">
      <a href="<%= url_for(params: request.query_parameters.except('status')) %>" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all <%= params[:status].blank? ? 'bg-white text-[#0F172A] shadow-sm border border-[#E2E8F0]' : 'text-[#64748B] hover:text-[#0F172A]' %>">
        <%= t('all') %>
      </a>
      <a href="<%= url_for(params: request.query_parameters.merge('status' => 'pending')) %>" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all <%= params[:status] == 'pending' ? 'bg-white text-[#0F172A] shadow-sm border border-[#E2E8F0]' : 'text-[#64748B] hover:text-[#0F172A]' %>">
        <%= t('pending') %>
      </a>
      <a href="<%= url_for(params: request.query_parameters.merge('status' => 'completed')) %>" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all <%= params[:status] == 'completed' ? 'bg-white text-[#0F172A] shadow-sm border border-[#E2E8F0]' : 'text-[#64748B] hover:text-[#0F172A]' %>">
        <%= t('completed') %>
      </a>
    </div>
    <div class="flex items-center md:items-end gap-2 w-full md:w-fit">
      <%= render 'submissions_filters/applied_filters', filter_params:, with_status: true %>
      <%= render 'submissions_filters/filter_button', filter_params: %>
      <%= render 'submissions_filters/actions', filter_params: %>
    </div>
  </div>
<% end %>

<% if @pagy.count.nil? || @pagy.count > 0 %>
  <div class="space-y-3 mb-6">
    <%= render partial: 'templates/submission', collection: @submissions, locals: { with_template: true } %>
  </div>
<% end %>

<% if @submissions.present? || (params[:q].blank? && filter_params.blank?) %>
  <% if @pagy.pages > 1 %>
    <%= render 'shared/pagination', pagy: @pagy, items_name: 'submissions', left_additional_html: view_archived_html %>
  <% else %>
    <div class="mt-4">
      <%= view_archived_html %>
    </div>
  <% end %>
<% elsif params[:q].present? || filter_params.present? %>
  <div class="text-center py-16">
    <div class="text-2xl font-bold text-[#0F172A]">
      <%= t('submissions_not_found') %>
    </div>
  </div>
<% end %>
