<div class="w-full max-w-5xl mx-auto px-4 py-6">
  <%= render 'shared/settings_nav' %>

  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 mb-1">
      <%= t('email_notifications') %>
    </h1>
    <p class="text-sm text-slate-500">
      Configure automated completion alerts, audit copies, and scheduled signature reminders.
    </p>
  </div>

  <div class="space-y-6">
    <!-- Card 1: Completion Notifications -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
      <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#1D72FE] flex items-center justify-center">
          <%= svg_icon('mail', class: 'w-5 h-5') %>
        </div>
        <div>
          <h2 class="text-base font-semibold text-slate-900">Signer Completion Alerts</h2>
          <p class="text-xs text-slate-500">Receive an email notification immediately when all parties complete signing</p>
        </div>
      </div>

      <% user_config = UserConfig.find_or_initialize_by(user: current_user, key: UserConfig::RECEIVE_COMPLETED_EMAIL) %>
      <% if can?(:manage, user_config) %>
        <%= form_for user_config, url: user_configs_path, method: :post do |f| %>
          <%= f.hidden_field :key %>
          <div class="property-row flex items-center justify-between p-4 rounded-xl bg-slate-50/60 border border-slate-200/60">
            <div>
              <span class="text-sm font-medium text-slate-800">
                <%= t('receive_notification_emails_on_completed_submission') %>
              </span>
              <p class="text-xs text-slate-500 mt-0.5">Send a confirmation email with download links when the document is completed</p>
            </div>
            <submit-form data-on="change" class="flex flex-none">
              <%= f.check_box :value, class: 'toggle toggle-primary', checked: user_config.value != false %>
            </submit-form>
          </div>
        <% end %>
      <% end %>

      <div class="mt-6 pt-6 border-t border-slate-100">
        <%= render 'bcc_form', config: @bcc_config %>
      </div>
    </div>

    <!-- Card 2: Email Reminders -->
    <% unless can?(:manage, :personalization_restricted) %>
      <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
        <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
            <%= svg_icon('clock', class: 'w-5 h-5') %>
          </div>
          <div>
            <h2 class="text-base font-semibold text-slate-900"><%= t('sign_request_email_reminders') %></h2>
            <p class="text-xs text-slate-500">Automatically send reminder emails to signers who haven't completed their documents</p>
          </div>
        </div>

        <%= render 'reminder_banner' %>
        <div class="mt-4">
          <%= render 'reminder_form', config: @reminder_config %>
        </div>
      </div>
    <% end %>
  </div>
</div>
