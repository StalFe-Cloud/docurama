<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Scan to Sign - <%= @template.name %> | Docurama</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      <% page_cqw = ->(px) { "#{px.to_f / (@page_size == 'A4' ? 794 : 816) * 100}cqw" } %>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background-color: #0f172a;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: #0f172a;
        margin: 0;
        padding: 0;
        min-height: 100vh;
      }
      .qr-page-wrapper {
        container-type: inline-size;
        width: 100%;
        max-width: <%= @page_size == 'A4' ? '794px' : '816px' %>;
        aspect-ratio: <%= @page_size == 'A4' ? '794 / 1123' : '816 / 1056' %>;
        margin: 32px auto;
      }
      .qr-page {
        width: 100%;
        height: 100%;
        padding: <%= page_cqw.call(64) %>;
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        display: grid;
        grid-template-rows: auto 1fr auto;
      }
      .qr-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        font-size: 22px;
        font-weight: 800;
        color: #0f172a;
      }
      .qr-logo img {
        height: 42px;
        border-radius: 10px;
      }
      .qr-content {
        align-self: center;
        text-align: center;
        min-width: 0;
      }
      .qr-header {
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #0f172a;
        margin-bottom: 24px;
        padding: 0 16px;
      }
      .qr-card-box {
        display: inline-block;
        padding: 24px;
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: 28px;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.08);
      }
      .qr-main svg {
        display: block;
        width: 320px;
        height: 320px;
        max-width: 100%;
        margin: 0 auto;
      }
      .qr-footer {
        font-size: 18px;
        font-weight: 600;
        color: #475569;
        margin-top: 28px;
        padding: 0 16px;
      }
      .qr-branding {
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        color: #94a3b8;
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
      }
      .print-button {
        position: fixed;
        right: 28px;
        top: 28px;
        z-index: 100;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        border-radius: 9999px;
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
        color: #ffffff;
        font-size: 15px;
        font-weight: 700;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.5);
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .print-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 28px -5px rgba(79, 70, 229, 0.6);
      }
      @media print {
        body { background: #ffffff; }
        .qr-page-wrapper { margin: 0; box-shadow: none; width: 100%; max-width: none; }
        .qr-page { border-radius: 0; box-shadow: none; padding: 0.5in; }
        .print-button { display: none !important; }
      }
    </style>
  </head>
  <body>
    <div class="qr-page-wrapper">
      <div class="qr-page">
        <div class="qr-logo">
          <img src="/logo.svg" alt="Docurama">
          <span>Docurama</span>
        </div>
        <div class="qr-content">
          <div class="qr-header"><%= @template.name %></div>
          <div class="qr-card-box">
            <div class="qr-main">
              <%== @qr_svg_code %>
            </div>
          </div>
          <div class="qr-footer">
            <%= t('scan_the_qr_code_above_with_your_phone_camera_to_open_and_sign_this_document') %>
          </div>
        </div>
        <div class="qr-branding">
          Certified by Docurama Digital Trust Engine &bull; RFC 3161 TSA
        </div>
      </div>
    </div>
    <button type="button" id="qr-print-button" class="print-button">
      <%= svg_icon('printer') %>
      <span>Print Poster</span>
    </button>
    <script nonce="<%= content_security_policy_nonce %>">
      document.getElementById('qr-print-button').addEventListener('click', function () {
        window.print();
      });
    </script>
  </body>
</html>
