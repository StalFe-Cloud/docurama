<div class="w-full max-w-5xl mx-auto px-4 py-6">
  <%= render 'shared/settings_nav' %>

  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 mb-1">
      SMS Notifications
    </h1>
    <p class="text-sm text-slate-500">
      Deliver signature requests and automated reminders directly to signers' mobile phones via SMS.
    </p>
  </div>

  <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
    <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
      <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
        <%= svg_icon('message', class: 'w-5 h-5') %>
      </div>
      <div>
        <h2 class="text-base font-semibold text-slate-900">SMS Gateway Configuration</h2>
        <p class="text-xs text-slate-500">Configure Twilio API credentials or a custom webhook SMS delivery gateway</p>
      </div>
    </div>

    <% value = @encrypted_config.value || {} %>
    <%= form_for @encrypted_config, url: settings_sms_path, method: :post, html: { autocomplete: 'off', class: 'space-y-5 max-w-2xl' } do |f| %>
      <%= f.fields_for :value do |ff| %>
        <div class="form-control">
          <%= ff.label :enabled, class: 'label cursor-pointer justify-between py-3.5 px-4 border border-slate-200/80 rounded-xl bg-slate-50/60 hover:bg-slate-50 transition-colors' do %>
            <div class="flex flex-col">
              <span class="font-semibold text-sm text-slate-800">Enable SMS Delivery</span>
              <span class="text-xs text-slate-500">Allow sending signature links and reminders via text message</span>
            </div>
            <%= ff.check_box :enabled, { class: 'toggle toggle-primary', checked: value['enabled'] == '1' || value['enabled'] == true }, '1', '0' %>
          <% end %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="form-control sm:col-span-2">
            <%= ff.label :provider, 'SMS Provider Gateway', class: 'label text-xs font-semibold text-slate-700' %>
            <%= ff.select :provider, options_for_select([['Twilio', 'twilio'], ['Custom Webhook Gateway', 'webhook']], value.fetch('provider', 'twilio')), {}, class: 'base-select bg-slate-50/50 focus:bg-white rounded-xl text-sm' %>
          </div>

          <div class="form-control sm:col-span-2">
            <%= ff.label :account_sid, 'Account SID / API Key', class: 'label text-xs font-semibold text-slate-700' %>
            <%= ff.text_field :account_sid, value: value['account_sid'], placeholder: 'ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx', class: 'base-input font-mono text-xs bg-slate-50/50 focus:bg-white rounded-xl' %>
          </div>

          <div class="form-control sm:col-span-2">
            <%= ff.label :auth_token, 'Auth Token / API Secret', class: 'label text-xs font-semibold text-slate-700' %>
            <%= ff.password_field :auth_token, value: value['auth_token'], placeholder: value['auth_token'].present? ? '********' : 'Enter Auth Token', class: 'base-input font-mono text-xs bg-slate-50/50 focus:bg-white rounded-xl' %>
          </div>

          <div class="form-control sm:col-span-2">
            <%= ff.label :from_number, 'From Phone Number or Messaging Service SID', class: 'label text-xs font-semibold text-slate-700' %>
            <%= ff.text_field :from_number, value: value['from_number'], placeholder: '+1234567890 or MGxxxxxxxxxxxxxxxx', class: 'base-input text-sm bg-slate-50/50 focus:bg-white rounded-xl' %>
          </div>

          <div class="form-control sm:col-span-2">
            <%= ff.label :message_template, 'Message Template (optional)', class: 'label text-xs font-semibold text-slate-700' %>
            <%= ff.text_area :message_template, value: value['message_template'].presence || "Please review and sign {{template_name}}: {{sign_url}}", rows: 3, class: 'textarea textarea-bordered w-full text-sm bg-slate-50/50 focus:bg-white rounded-xl' %>
            <span class="text-xs text-slate-500 mt-1.5 flex items-center gap-1">Variables: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-700 font-mono text-[11px]">{{template_name}}</code>, <code class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-700 font-mono text-[11px]">{{sign_url}}</code></span>
          </div>
        </div>
      <% end %>

      <div class="form-control pt-4 flex flex-row items-center gap-4">
        <%= f.button button_title(title: t('save'), disabled_with: t('saving')), class: 'base-button px-6 py-2.5 rounded-xl text-sm font-semibold' %>
        <% if @encrypted_config.persisted? && value.present? %>
          <%= button_to 'Reset Settings', settings_sms_path(@encrypted_config), method: :delete, class: 'btn btn-ghost btn-sm text-error rounded-xl', data: { turbo_confirm: t('are_you_sure_') } %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
