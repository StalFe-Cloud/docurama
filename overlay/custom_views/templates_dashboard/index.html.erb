<% show_dropzone = @templates.blank? && @template_folders.blank? && params[:q].blank? %>
<% view_archived_html = capture do %>
  <% if can?(:manage, :countless) || current_account.templates.where.not(archived_at: nil).exists? %>
    <div>
      <a href="<%= templates_archived_index_path %>" class="link text-sm text-[#64748B] hover:text-[#1D72FE]"><%= t('view_archived') %></a>
    </div>
  <% end %>
<% end %>
<% templates_order_select_html = capture do %>
  <% if @templates.present? %>
    <%= render 'shared/templates_order_select' %>
  <% end %>
<% end %>
<% if Docuseal.demo? %><%= render 'shared/demo_alert' %><% end %>
<dashboard-dropzone class="contents" data-submit-on-upload="true">
  <div class="group/header flex justify-between items-center w-full mb-6">
    <div class="flex items-center flex-grow min-w-0 max-md:group-has-[search-input:focus-within]/header:hidden <%= 'max-md:hidden' if params[:q].present? %>">
      <div class="mr-3">
        <%= render 'dashboard/toggle_view', selected: 'templates' %>
      </div>
      <h1 class="text-2xl md:text-3xl font-bold truncate tracking-tight text-[#0F172A] <%= 'hidden' if params[:q].present? %>">
        <%= t('templates') %>
      </h1>
    </div>
    <div class="flex space-x-2 max-md:has-[search-input:focus-within]:grow <%= 'max-md:grow' if params[:q].present? %>">
      <% if params[:q].present? || @pagy.pages > 1 || @template_folders.present? %>
        <%= render 'shared/search_input' %>
      <% end %>
      <% if can?(:create, ::Template) %>
        <span class="hidden sm:block">
          <%= render 'templates/upload_button' %>
        </span>
        <open-modal-mobile data-disabled="<%= !Docuseal.multitenant? %>" class="flex">
          <%= link_to new_template_path, class: 'btn btn-primary gap-2 shadow-sm', data: { turbo_frame: :modal } do %>
            <%= svg_icon('plus', class: 'w-5 h-5 stroke-2') %>
            <span class="hidden md:block font-semibold"><%= t('create') %></span>
          <% end %>
        </open-modal-mobile>
      <% end %>
    </div>
  </div>

  <% if @template_folders.present? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mb-6">
      <%= render partial: 'template_folders/folder', collection: @template_folders %>
    </div>
  <% end %>

  <% if @templates.present? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mb-6">
      <%= render partial: 'templates/template', collection: @templates %>
    </div>
  <% end %>

  <% if show_dropzone %>
    <div class="mb-8">
      <div class="p-6 rounded-2xl bg-gradient-to-r from-[#EFF6FF] via-[#F8FAFC] to-[#EFF6FF] border border-[#BFDBFE]/60 mb-6 flex flex-col md:flex-row items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold text-[#0F172A] mb-1">Welcome to Docurama</h2>
          <p class="text-sm text-[#475569]">Create your first electronic signature workflow in seconds. Upload any PDF or document below.</p>
        </div>
        <%= link_to new_template_path, class: 'btn btn-primary shrink-0 shadow-md', data: { turbo_frame: :modal } do %>
          <%= svg_icon('plus', class: 'w-5 h-5 stroke-2') %>
          <span>Get Started</span>
        <% end %>
      </div>
      <%= render 'templates/dropzone' %>
    </div>
  <% end %>

  <% if @templates.present? || @template_folders.present? || params[:q].blank? %>
    <% if @pagy.pages > 1 %>
      <%= render 'shared/pagination', pagy: @pagy, items_name: @templates.present? ? 'templates' : 'template_folders', left_additional_html: view_archived_html, right_additional_html: templates_order_select_html %>
    <% else %>
      <div class="mt-4">
        <%= view_archived_html %>
      </div>
    <% end %>
  <% elsif params[:q].present? %>
    <div class="text-center py-16">
      <div class="text-2xl font-bold text-[#0F172A]">
        <%= t('templates_not_found') %>
      </div>
    </div>
  <% end %>
</dashboard-dropzone>
