<div class="w-full max-w-4xl mx-auto">
  <%= render 'shared/settings_nav' %>

  <div class="space-y-8">
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-200">
      <div>
        <h1 class="text-3xl font-extrabold text-[#0F172A] tracking-tight">
          <%= t('account') %> & Workspace Settings
        </h1>
        <p class="text-sm text-slate-500 mt-1">
          Manage your organization profile, regulatory compliance, and electronic signature configurations.
        </p>
      </div>
    </div>

    <!-- Card 1: Workspace & General Settings -->
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm">
      <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#1D72FE] flex items-center justify-center font-bold">
          <%= svg_icon('building', class: 'w-5 h-5') %>
        </div>
        <div>
          <h2 class="text-lg font-bold text-[#0F172A]"><%= t('company_name') %> & Localization</h2>
          <p class="text-xs text-slate-500">Define the workspace identifier, timezone, and language preferences.</p>
        </div>
      </div>

      <%= form_for '', url: settings_account_path, method: :patch, html: { autocomplete: 'off', class: 'space-y-6' } do |f| %>
        <%= fields_for current_account do |ff| %>
          <div class="form-control">
            <%= ff.label :name, t('company_name'), class: 'block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2' %>
            <%= ff.text_field :name, required: true, class: 'base-input w-full h-11 px-3.5', dir: 'auto', placeholder: 'Acme Corporation' %>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <div class="form-control">
              <%= ff.label :timezone, t('time_zone'), class: 'block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2' %>
              <%= ff.select :timezone, nil, {}, class: 'base-select h-11 px-3.5' do %>
                <% tzinfo = TZInfo::Timezone.get(ActiveSupport::TimeZone::MAPPING[current_account.timezone] || current_account.timezone) %>
                <% items = ActiveSupport::TimeZone.all.map { |z| [z.to_s, z.name] } %>
                <% items.unshift([tzinfo.to_s, current_account.timezone]) unless ActiveSupport::TimeZone.all.find { |e| e.tzinfo == tzinfo } %>
                <%= options_for_select(items, current_account.timezone) %>
              <% end %>
            </div>

            <div class="form-control">
              <%= ff.label :locale, t('language'), class: 'block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2' %>
              <%= ff.select :locale, options_for_select(AccountsController::LOCALE_OPTIONS.invert, current_account.locale), {}, class: 'base-select h-11 px-3.5' %>
            </div>
          </div>

          <div class="flex justify-end pt-2">
            <%= f.button button_title(title: t('save'), disabled_with: t('saving')), class: 'btn btn-primary px-6 h-11 font-semibold shadow-sm' %>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Card 2: Security & Authentication (2FA) -->
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm">
      <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold">
          <%= svg_icon('shield_check', class: 'w-5 h-5') %>
        </div>
        <div>
          <h2 class="text-lg font-bold text-[#0F172A]">Authentication & Access Security</h2>
          <p class="text-xs text-slate-500">Enforce organizational security safeguards and access policies.</p>
        </div>
      </div>

      <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::FORCE_MFA) %>
      <% if can?(:manage, account_config) %>
        <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
          <%= f.hidden_field :key %>
          <div class="property-row">
            <div>
              <div class="font-bold text-sm text-[#0F172A]"><%= t('force_2fa_with_authenticator_app') %></div>
              <div class="text-xs text-slate-500 max-w-lg mt-0.5">
                Require all members of this workspace to configure Time-Based One-Time Password (TOTP) two-factor authentication before accessing documents.
              </div>
            </div>
            <submit-form data-on="change" class="flex">
              <%= f.check_box :value, class: 'toggle toggle-primary', checked: account_config.value %>
            </submit-form>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Card 3: 21 CFR Part 11 & Compliance Policies -->
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm">
      <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
          <%= svg_icon('discount_check_filled', class: 'w-5 h-5') %>
        </div>
        <div>
          <h2 class="text-lg font-bold text-[#0F172A]">Regulatory Compliance & 21 CFR Part 11</h2>
          <p class="text-xs text-slate-500">Configure cryptographic traceability, signing reasons, and audit trails.</p>
        </div>
      </div>

      <div class="divide-y divide-slate-100">
        <!-- Signature ID -->
        <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::WITH_SIGNATURE_ID) %>
        <% if can?(:manage, account_config) %>
          <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
            <%= f.hidden_field :key %>
            <div class="property-row">
              <div>
                <div class="font-bold text-sm text-[#0F172A]"><%= t('add_signature_id_to_the_documents') %></div>
                <div class="text-xs text-slate-500 max-w-lg mt-0.5">
                  Embeds a unique cryptographic Signature ID and UTC timestamp to each signature for full audit traceability.
                </div>
              </div>
              <submit-form data-on="change" class="flex">
                <%= f.check_box :value, class: 'toggle toggle-primary', checked: account_config.value %>
              </submit-form>
            </div>
          <% end %>
        <% end %>

        <!-- Require Signing Reason -->
        <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::REQUIRE_SIGNING_REASON_KEY) %>
        <% if can?(:manage, account_config) %>
          <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
            <%= f.hidden_field :key %>
            <div class="property-row">
              <div>
                <div class="font-bold text-sm text-[#0F172A]"><%= t('require_signing_reason') %></div>
                <div class="text-xs text-slate-500 max-w-lg mt-0.5">
                  Signers must provide an explicit legal purpose (e.g. approval, certification, review) prior to completing their signature.
                </div>
              </div>
              <submit-form data-on="change" class="flex">
                <%= f.check_box :value, class: 'toggle toggle-primary', checked: account_config.value %>
              </submit-form>
            </div>
          <% end %>
        <% end %>

        <!-- Combine PDF & Audit Log -->
        <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::COMBINE_PDF_RESULT_KEY) %>
        <% if can?(:manage, account_config) %>
          <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
            <%= f.hidden_field :key %>
            <div class="property-row">
              <div>
                <div class="font-bold text-sm text-[#0F172A]"><%= t('combine_completed_documents_and_audit_log') %></div>
                <div class="text-xs text-slate-500 max-w-lg mt-0.5">
                  Merges completed documents with a tamper-evident audit certificate in a unified, compliance-ready PDF.
                </div>
              </div>
              <submit-form data-on="change" class="flex">
                <%= f.check_box :value, class: 'toggle toggle-primary', checked: account_config.value %>
              </submit-form>
            </div>
          <% end %>
        <% end %>

        <!-- Enforce Signing Order -->
        <% if !Docuseal.multitenant? || can?(:manage, :personalization_advanced) %>
          <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::ENFORCE_SIGNING_ORDER_KEY) %>
          <% if can?(:manage, account_config) %>
            <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
              <%= f.hidden_field :key %>
              <div class="property-row">
                <div>
                  <div class="font-bold text-sm text-[#0F172A]"><%= t('always_enforce_signing_order') %></div>
                  <div class="text-xs text-slate-500 max-w-lg mt-0.5">
                    Enforces strict sequential recipient routing where subsequent signers only receive documents after prior parties sign.
                  </div>
                </div>
                <submit-form data-on="change" class="flex">
                  <%= f.check_box :value, class: 'toggle toggle-primary', checked: account_config.value %>
                </submit-form>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Card 4: Signer Experience & Link Security -->
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm">
      <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
          <%= svg_icon('writing_sign', class: 'w-5 h-5') %>
        </div>
        <div>
          <h2 class="text-lg font-bold text-[#0F172A]">Signer Experience & Link Protection</h2>
          <p class="text-xs text-slate-500">Control signing modes, recipient pre-fill, and file expiration parameters.</p>
        </div>
      </div>

      <div class="divide-y divide-slate-100">
        <!-- Expirable Links -->
        <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::DOWNLOAD_LINKS_EXPIRE_KEY) %>
        <% if can?(:manage, account_config) %>
          <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
            <%= f.hidden_field :key %>
            <div class="property-row">
              <div>
                <div class="font-bold text-sm text-[#0F172A]"><%= t('expirable_file_download_links') %></div>
                <div class="text-xs text-slate-500 max-w-lg mt-0.5">
                  Download URLs automatically expire after 40 minutes to prevent unauthorized archival access.
                </div>
              </div>
              <submit-form data-on="change" class="flex">
                <%= f.check_box :value, class: 'toggle toggle-primary', checked: account_config.value != false %>
              </submit-form>
            </div>
          <% end %>
        <% end %>

        <!-- Require Auth for Downloads -->
        <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::DOWNLOAD_LINKS_AUTH_KEY) %>
        <% if can?(:manage, account_config) %>
          <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
            <%= f.hidden_field :key %>
            <div class="property-row">
              <div>
                <div class="font-bold text-sm text-[#0F172A]"><%= t('require_authentication_for_file_download_links') %></div>
                <div class="text-xs text-slate-500 max-w-lg mt-0.5">
                  Requires verified login or authorized API credentials before allowing document download access.
                </div>
              </div>
              <submit-form data-on="change" class="flex">
                <%= f.check_box :value, class: 'toggle toggle-primary', checked: account_config.value %>
              </submit-form>
            </div>
          <% end %>
        <% end %>

        <!-- Remember & Pre-fill -->
        <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::FORM_PREFILL_SIGNATURE_KEY) %>
        <% if can?(:manage, account_config) %>
          <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
            <%= f.hidden_field :key %>
            <div class="property-row">
              <div>
                <div class="font-bold text-sm text-[#0F172A]"><%= t('remember_and_pre_fill_signatures') %></div>
                <div class="text-xs text-slate-500 max-w-lg mt-0.5">
                  Securely remembers user signature preferences to expedite repeat signing sessions.
                </div>
              </div>
              <submit-form data-on="change" class="flex">
                <%= f.check_box :value, class: 'toggle toggle-primary', checked: account_config.value != false %>
              </submit-form>
            </div>
          <% end %>
        <% end %>

        <!-- Resubmit Completed Forms -->
        <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::ALLOW_TO_RESUBMIT) %>
        <% if can?(:manage, account_config) %>
          <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
            <%= f.hidden_field :key %>
            <div class="property-row">
              <div>
                <div class="font-bold text-sm text-[#0F172A]"><%= t('allow_to_resubmit_completed_forms') %></div>
                <div class="text-xs text-slate-500 max-w-lg mt-0.5">
                  Allows recipients to initiate amendments to previously submitted forms when requested.
                </div>
              </div>
              <submit-form data-on="change" class="flex">
                <%= f.check_box :value, class: 'toggle toggle-primary', checked: account_config.value %>
              </submit-form>
            </div>
          <% end %>
        <% end %>

        <!-- Decline Documents -->
        <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::ALLOW_TO_DECLINE_KEY) %>
        <% if can?(:manage, account_config) %>
          <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
            <%= f.hidden_field :key %>
            <div class="property-row">
              <div>
                <div class="font-bold text-sm text-[#0F172A]"><%= t('allow_to_decline_documents') %></div>
                <div class="text-xs text-slate-500 max-w-lg mt-0.5">
                  Permits recipients to decline signing with an optional stated justification.
                </div>
              </div>
              <submit-form data-on="change" class="flex">
                <%= f.check_box :value, class: 'toggle toggle-primary', checked: account_config.value %>
              </submit-form>
            </div>
          <% end %>
        <% end %>

        <!-- Delegate Documents -->
        <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::ALLOW_TO_DELEGATE_KEY) %>
        <% if can?(:manage, account_config) %>
          <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
            <%= f.hidden_field :key %>
            <div class="property-row">
              <div>
                <div class="font-bold text-sm text-[#0F172A]"><%= t('allow_to_delegate_documents') %></div>
                <div class="text-xs text-slate-500 max-w-lg mt-0.5">
                  Allows designated signers to re-assign signing responsibility to another authorized party.
                </div>
              </div>
              <submit-form data-on="change" class="flex">
                <%= f.check_box :value, class: 'toggle toggle-primary', checked: account_config.value %>
              </submit-form>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Card 5: Danger Zone -->
    <% if can?(:manage, current_account) && Docuseal.multitenant? && true_user == current_user %>
      <div class="bg-red-50/50 rounded-2xl p-6 sm:p-8 border border-red-200 shadow-sm">
        <h2 class="text-lg font-bold text-red-700 mb-1">
          <%= t('danger_zone') %>
        </h2>
        <p class="text-xs text-red-600/80 mb-4 max-w-lg">
          Permanently deletes this workspace, all active templates, signed documents, and associated cryptographic audit logs. This operation cannot be undone.
        </p>
        <%= button_to button_title(title: t('delete_my_account')), settings_account_path, class: 'btn btn-outline btn-error font-semibold', data: { turbo_confirm: t('you_are_scheduling_your_account_for_deletion_after_deletion_your_data_will_be_permanently_removed_and_cannot_be_recovered_click_ok_if_you_would_like_to_continue') }, method: :delete, id: :account_delete_button %>
      </div>
    <% end %>
  </div>
</div>
