<div class="w-full max-w-5xl mx-auto px-4 py-6">
  <%= render 'shared/settings_nav' %>

  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 mb-1">
      <%= t('profile') %>
    </h1>
    <p class="text-sm text-slate-500">
      Manage your personal credentials, digital signature stamps, and account authentication.
    </p>
  </div>

  <div class="space-y-6">
    <!-- Card 1: Personal Profile -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
      <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#1D72FE] to-[#3B82F6] flex items-center justify-center text-white font-bold text-base shadow-sm">
          <%= current_user.first_name.presence&.first&.upcase || current_user.email.first.upcase %>
        </div>
        <div>
          <h2 class="text-base font-semibold text-slate-900">Personal Information</h2>
          <p class="text-xs text-slate-500">Your profile details displayed to document signers and team members</p>
        </div>
      </div>

      <%= form_for current_user, url: update_contact_settings_profile_index_path, method: :patch, html: { autocomplete: 'off', class: 'space-y-4' } do |f| %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="form-control">
            <%= f.label :first_name, t('first_name'), class: 'label text-xs font-semibold text-slate-700' %>
            <%= f.text_field :first_name, required: true, class: 'base-input bg-slate-50/50 focus:bg-white transition-all', dir: 'auto' %>
          </div>
          <div class="form-control">
            <%= f.label :last_name, t('last_name'), class: 'label text-xs font-semibold text-slate-700' %>
            <%= f.text_field :last_name, required: false, class: 'base-input bg-slate-50/50 focus:bg-white transition-all', dir: 'auto' %>
          </div>
        </div>
        <div class="form-control">
          <%= f.label :email, t('email'), class: 'label text-xs font-semibold text-slate-700' %>
          <%= f.email_field :email, autocomplete: 'off', class: 'base-input bg-slate-50/50 focus:bg-white transition-all' %>
          <% if current_user.try(:pending_reconfirmation?) %>
            <label class="label">
              <span class="label-text-alt text-amber-600 font-medium"><%= t('email_address_is_awaiting_confirmation_follow_the_link_in_the_email_to_confirm', email: f.object.unconfirmed_email) %></span>
            </label>
          <% end %>
        </div>
        <div class="pt-2 flex justify-end">
          <%= f.button button_title(title: t('update'), disabled_with: t('updating')), class: 'base-button px-6 py-2.5 rounded-xl text-sm font-semibold' %>
        </div>
      <% end %>

      <%= render 'email_configs' %>
    </div>

    <!-- Card 2: Signature & Initials Stamps -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
      <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#1D72FE] flex items-center justify-center">
          <%= svg_icon('writing_sign', class: 'w-5 h-5') %>
        </div>
        <div>
          <h2 class="text-base font-semibold text-slate-900">Pre-saved Signature & Initials</h2>
          <p class="text-xs text-slate-500">Your electronic signature stamps automatically applied when you sign documents</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <!-- Signature Box -->
        <div class="rounded-xl border border-slate-200/90 p-4 bg-slate-50/50 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500"><%= t('signature') %></span>
              <% signature = UserConfigs.load_signature(current_user) %>
              <% if signature %>
                <span class="badge badge-sm badge-success text-white">Active</span>
              <% else %>
                <span class="badge badge-sm badge-neutral badge-outline">None</span>
              <% end %>
            </div>
            <div class="h-32 rounded-lg bg-white border border-slate-200/60 flex items-center justify-center p-3 relative overflow-hidden">
              <% if signature %>
                <%= button_to button_title(title: t('remove'), disabled_with: t('removing')), user_signature_path, method: :delete, class: 'right-2 top-2 absolute text-xs font-semibold text-red-500 hover:text-red-700 bg-red-50 hover:bg-red-100 px-2 py-0.5 rounded-md transition-colors' %>
                <img src="<%= signature.url(time: ActiveStorage::Attachment.service_url_time) %>" class="max-h-full max-w-full object-contain">
              <% else %>
                <div class="text-center text-slate-400">
                  <%= svg_icon('writing_sign', class: 'w-8 h-8 mx-auto mb-1 opacity-40') %>
                  <p class="text-xs">No signature saved yet</p>
                </div>
              <% end %>
            </div>
          </div>
          <div class="mt-4">
            <a href="<%= edit_user_signature_path %>" data-turbo-frame="modal" class="white-button w-full text-xs font-semibold text-center block py-2 rounded-xl">
              <%= t('update_signature') %>
            </a>
          </div>
        </div>

        <!-- Initials Box -->
        <div class="rounded-xl border border-slate-200/90 p-4 bg-slate-50/50 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500"><%= t('initials') %></span>
              <% initials = UserConfigs.load_initials(current_user) %>
              <% if initials %>
                <span class="badge badge-sm badge-success text-white">Active</span>
              <% else %>
                <span class="badge badge-sm badge-neutral badge-outline">None</span>
              <% end %>
            </div>
            <div class="h-32 rounded-lg bg-white border border-slate-200/60 flex items-center justify-center p-3 relative overflow-hidden">
              <% if initials %>
                <%= button_to button_title(title: t('remove'), disabled_with: t('removing')), user_initials_path, method: :delete, class: 'right-2 top-2 absolute text-xs font-semibold text-red-500 hover:text-red-700 bg-red-50 hover:bg-red-100 px-2 py-0.5 rounded-md transition-colors' %>
                <img src="<%= initials.url(time: ActiveStorage::Attachment.service_url_time) %>" class="max-h-full max-w-full object-contain">
              <% else %>
                <div class="text-center text-slate-400">
                  <%= svg_icon('letter_case_upper', class: 'w-8 h-8 mx-auto mb-1 opacity-40') %>
                  <p class="text-xs">No initials saved yet</p>
                </div>
              <% end %>
            </div>
          </div>
          <div class="mt-4">
            <a href="<%= edit_user_initials_path %>" data-turbo-frame="modal" class="white-button w-full text-xs font-semibold text-center block py-2 rounded-xl">
              <%= t('update_initials') %>
            </a>
          </div>
        </div>
      </div>
    </div>

    <% if true_user == current_user && !current_account.testing? %>
      <!-- Card 3: Password & Credentials -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
        <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
            <%= svg_icon('lock', class: 'w-5 h-5') %>
          </div>
          <div>
            <h2 class="text-base font-semibold text-slate-900"><%= t('change_password') %></h2>
            <p class="text-xs text-slate-500">Ensure your account is protected with a long, unique password</p>
          </div>
        </div>

        <%= form_for current_user, url: update_password_settings_profile_index_path, method: :patch, html: { autocomplete: 'off', class: 'space-y-4 max-w-xl' } do |f| %>
          <div class="form-control">
            <%= f.label :password, t('new_password'), class: 'label text-xs font-semibold text-slate-700' %>
            <%= f.password_field :password, autocomplete: 'off', class: 'base-input peer w-full bg-slate-50/50 focus:bg-white', required: true, placeholder: 'Enter new password' %>
          </div>
          <div class="<%= 'peer-invalid:hidden' if current_user.errors.blank? %> space-y-4">
            <div class="form-control">
              <%= f.label :password_confirmation, t('confirm_password'), class: 'label text-xs font-semibold text-slate-700' %>
              <%= f.password_field :password_confirmation, autocomplete: 'off', class: 'base-input bg-slate-50/50 focus:bg-white', placeholder: 'Confirm new password' %>
            </div>
            <div class="form-control">
              <%= f.label :current_password, t('current_password'), class: 'label text-xs font-semibold text-slate-700' %>
              <%= f.password_field :current_password, autocomplete: 'current-password', class: 'base-input bg-slate-50/50 focus:bg-white', placeholder: 'Enter your current password' %>
              <% if Docuseal.multitenant? || Accounts.can_send_emails?(current_account) %>
                <span class="label-text-alt mt-1.5 text-xs text-slate-500">
                  <%= t('dont_remember_your_current_password_click_here_to_reset_it_html') %>
                </span>
              <% end %>
            </div>
            <div class="pt-2">
              <%= f.button button_title(title: t('update'), disabled_with: t('updating')), class: 'base-button px-6 py-2.5 rounded-xl text-sm font-semibold' %>
            </div>
          </div>
        <% end %>
        <%= button_to nil, user_send_reset_password_path(current_user), id: 'resend_password_button', method: :put, class: 'hidden', data: { turbo_confirm: t('are_you_sure_') } %>
      </div>

      <!-- Card 4: Two-Factor Authentication -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
        <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
          <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
            <%= svg_icon('shield_check', class: 'w-5 h-5') %>
          </div>
          <div>
            <h2 class="text-base font-semibold text-slate-900"><%= t('two_factor_authentication') %></h2>
            <p class="text-xs text-slate-500">Add an extra layer of defense with an authenticator app (TOTP)</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl border border-slate-100 bg-slate-50/50">
          <div class="flex items-center space-x-3">
            <% if current_user.otp_required_for_login %>
              <%= svg_icon('circle_check', class: 'stroke-success w-6 h-6 flex-none text-emerald-500') %>
              <div>
                <p class="text-sm font-semibold text-slate-900"><%= t('2fa_has_been_configured') %></p>
                <p class="text-xs text-slate-500">Your account requires a 6-digit TOTP code on every sign-in</p>
              </div>
            <% else %>
              <%= svg_icon('info_circle', class: 'stroke-warning w-6 h-6 flex-none text-amber-500') %>
              <div>
                <p class="text-sm font-semibold text-slate-900"><%= t('2fa_is_not_configured') %></p>
                <p class="text-xs text-slate-500">We strongly recommend enabling 2FA to protect your account</p>
              </div>
            <% end %>
          </div>
          <div>
            <% if current_user.otp_required_for_login %>
              <a href="<%= edit_mfa_setup_path %>" data-turbo-frame="modal" class="btn btn-outline btn-error btn-sm rounded-xl text-xs font-semibold px-4">
                <%= t('remove_2fa') %>
              </a>
            <% else %>
              <a href="<%= new_mfa_setup_path %>" data-turbo-frame="modal" class="base-button text-xs font-semibold px-5 py-2 rounded-xl">
                <%= t('set_up_2fa') %>
              </a>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
