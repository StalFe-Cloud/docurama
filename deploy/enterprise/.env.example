# Docurama Enterprise Self-Host Configuration
# Dedicated environment settings for https://docurama.stalfe.com

# ------------------------------------------------------------------
# Deployment Mode & Identity
# ------------------------------------------------------------------
DOCURAMA_ENV=production
DOCURAMA_DEPLOYMENT_MODE=selfhost
DOCURAMA_APP_URL=https://docurama.stalfe.com
DOCURAMA_COOKIE_SECURE=true
DOCURAMA_PUBLIC_REGISTRATION=false

# ------------------------------------------------------------------
# Cryptographic Signing & PKCS#12 Certificate
# ------------------------------------------------------------------
DOCURAMA_P12_PATH=/app/certs/docurama_document_signing_cert.p12
DOCURAMA_P12_PASSWORD=change_this_p12_password
DOCURAMA_ROOT_CA_PATH=/app/certs/docurama_root_ca.crt
DOCURAMA_TSA_URL=http://timestamp.digicert.com

# ------------------------------------------------------------------
# Security Secrets
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------------
DOCURAMA_SECRET_KEY=change_this_to_a_random_48_char_secret_key

# ------------------------------------------------------------------
# Database (PostgreSQL isolated container)
# ------------------------------------------------------------------
POSTGRES_USER=docurama
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password
POSTGRES_DB=docurama
DOCURAMA_DATABASE_URL=postgresql+asyncpg://docurama:change_this_to_a_secure_postgres_password@docurama-enterprise-db:5432/docurama
DOCURAMA_SYNC_DATABASE_URL=postgresql://docurama:change_this_to_a_secure_postgres_password@docurama-enterprise-db:5432/docurama

# ------------------------------------------------------------------
# Storage Layout
# ------------------------------------------------------------------
DOCURAMA_STORAGE_DIR=/app/storage
FORWARDED_ALLOW_IPS=*
DOCURAMA_REMINDERS_ENABLED=true
