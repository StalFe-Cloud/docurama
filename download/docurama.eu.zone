; ─────────────────────────────────────────────────────────────────────────────
; Docurama SAS — 1 Rue Marguerin, 75014 Paris, France
; DNS zone: docurama.eu — generated by the Docurama platform console
; Provisioned: 2026-09-14T09:24:06.523Z
; Replace 51.75.20.14 / 51.75.124.20 with production origin IPs and
; spf.eu.mailrelay.io / domainkey targets with your chosen mail provider.
; ─────────────────────────────────────────────────────────────────────────────
$ORIGIN docurama.eu.
$TTL 3600

@            SOA    ns1.docurama.eu. hostmaster.docurama.eu. (
                    2026091401   ; serial YYYYMMDDnn
                    7200        ; refresh
                    3600        ; retry
                    1209600     ; expire
                    3600 )      ; negative TTL

; ── Nameservers ──
@            NS     ns1.docurama.eu.
@            NS     ns2.docurama.eu.
ns1          A      51.75.20.14
ns2          A      51.75.20.15

; ── Hosts & sub-domains ──
@            A      51.75.20.14                        ; LIVE — Marketing site, legal pages (privacy, terms, imprint) and 301 redirect to www
www          CNAME  docurama.eu.                       ; LIVE — Primary marketing hostname served by the same origin
app          A      51.75.20.14                        ; LIVE — Enterprise portal & admin console — this application (signing workspaces)
verify       A      51.75.20.14                        ; LIVE — Public cryptographic verification portal — anyone can validate a sealed document
api          A      51.75.20.14                        ; LIVE — REST API for integrations, API keys and webhook deliveries
admin        A      51.75.20.14                        ; PENDING — Hardened internal operations entry — IP allowlist + SSO enforcement
mail         A      51.75.124.20                       ; PENDING — Outbound SMTP relay FQDN (rDNS/PTR target) and webmail administration
mta-sts      A      51.75.20.14                        ; LIVE — MTA-STS policy host — serves /.well-known/mta-sts.txt over HTTPS
status       A      51.75.20.14                        ; LIVE — Public status & uptime page with incident history
docs         A      51.75.20.14                        ; PENDING — Product guides and public API documentation
staging      A      51.75.20.15                        ; PENDING — Pre-production environment for release verification before deploy

; ── Mail exchangers ──
@            MX     10   mail.docurama.eu.      ; Primary inbound mail exchanger (self-hosted relay).
@            MX     20   mx-backup.eu.mailrelay.io. ; Secondary queue exchanger from the EU relay provider (to be updated with the chosen provider).

; ── SPF / DMARC / MTA-STS / TLS-RPT (TXT) ──
@                        TXT    "v=spf1 include:spf.eu.mailrelay.io -all"        ; SPF [verified]
_dmarc                   TXT    "v=DMARC1; p=quarantine; rua=mailto:dmarc@docurama.eu; ruf=mailto:dmarc@docurama.eu; adkim=s; aspf=s; fo=1; pct=100" ; DMARC [verified]
_mta-sts                 TXT    "v=STSv1; id=2026091401"                         ; MTA-STS [verified]
_smtp._tls               TXT    "v=TLSRPTv1; rua=mailto:dmarc@docurama.eu"       ; TLS-RPT

; ── DKIM (CNAME to provider) ──
s1._domainkey            CNAME  s1.domainkey.docurama.eu.mailrelay.io. ; DKIM signing key selector 1 (2048-bit RSA), published by the relay provider.
s2._domainkey            CNAME  s2.domainkey.docurama.eu.mailrelay.io. ; DKIM signing key selector 2 (rotation).

; ── Certificate Authority Authorisation ──
@            CAA    0 issue "letsencrypt.org" ; Only Let's Encrypt may issue certificates for the zone.
@            CAA    0 iodef "mailto:security@docurama.eu" ; Certificate issuance violations reported to security@docurama.eu.

; ── Reverse DNS for the outbound relay (at the provider / ARIN zone) ──
; 20.124.75.51.in-addr.arpa. 3600 IN PTR mail.docurama.eu.
