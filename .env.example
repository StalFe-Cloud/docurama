# Docurama Environment Configuration Example

# Domain & Host
HOST=docurama.stalfe.com
APP_URL=https://docurama.stalfe.com
PRODUCT_NAME=Docurama
FORCE_SSL=true
PORT=3000

# Database
POSTGRES_USER=docurama
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=docurama

# Cryptographic PAdES-LTV / RFC 3161 TSA
TIMESERVER_URL=http://timestamp.digicert.com
CERT_PASSWORD=change_this_to_your_p12_password

# JWT Secret & Security (Clean-Room Backend)
JWT_SECRET=generate_a_random_secret_string_for_production
