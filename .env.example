# Docurama Environment Configuration Template

# Database: SQLite for local/embedded, or PostgreSQL: postgresql://user:pass@host:5432/docurama
DATABASE_URL="file:./db/docurama.db"

# Session & Security
SESSION_SECRET="change-this-in-production-to-a-random-secret"
DOCURAMA_BOOTSTRAP_EMAIL="admin@docurama.local"
DOCURAMA_BOOTSTRAP_PASSWORD="ChangeMe123!"

# Storage
STORAGE_DIR="./storage"

# App URL
APP_URL="http://localhost:3000"

