# Copy to .env and adjust. Never commit .env itself.

# Prisma / SQLite. Must be an absolute path (file:/// on Windows, file:/ on POSIX).
# Windows example: file:///D:/Dev/Under-Development/Docurama/db/custom.db
DATABASE_URL="file:./db/custom.db"

# Where uploaded documents are written. Created on first upload.
# Keep this outside the repo in production.
STORAGE_DIR="./storage"

# ── Document storage: S3-compatible object storage (optional) ────────────────
# Unset = local filesystem under STORAGE_DIR (single-node default).
# When set, document bytes live in object storage instead — the multitenant /
# scale-out path. Works with SeaweedFS (docker compose --profile s3), MinIO,
# Garage, Ceph RGW, AWS S3, Cloudflare R2, Backblaze B2… (docs/STORAGE-OPTIONS.md)
# Use S3_BUCKET with a complete static key pair, or S3_CREDENTIALS_MODE=default
# for the AWS SDK credential chain (instance/task role). Partial configuration fails closed.
#S3_ENDPOINT="http://127.0.0.1:8333"
#S3_BUCKET="docurama"
#S3_ACCESS_KEY_ID=""
#S3_SECRET_ACCESS_KEY=""
#S3_REGION="us-east-1"
#S3_CREDENTIALS_MODE="static"
#S3_SESSION_TOKEN=""
#S3_SERVER_SIDE_ENCRYPTION="aws:kms"
#S3_SSE_KMS_KEY_ID=""
# Auto-create the bucket on first use (default 1; set 0 to manage it yourself).
#S3_AUTO_CREATE_BUCKET="1"

# Renders the one-click demo credential buttons on the sign-in page.
# Must be unset or "false" in production.
NEXT_PUBLIC_DEMO_MODE="false"

# ── Deployment shape ──────────────────────────────────────────────────────────

# Base domain for the vanity sub-domain routing (status./docs./security./
# verify./mail./sign./api./admin.). Self-hosted / white-label deployments set
# their own domain; the default is the Docurama production zone.
#ROOT_DOMAIN="docurama.eu"
# Host for sign-in and the workspace. Apex /login, /welcome, /settings, …
# redirect there (session cookies are host-only). Defaults to app.docurama.eu
# when ROOT_DOMAIN is docurama.eu; set it for your own domain, or "off".
#APP_HOST="app.example.com"
# Links in emails the background worker sends (automated reminders) use
# APP_URL, else https://APP_HOST. Set it when the app is served elsewhere.
#APP_URL="https://app.example.com"

# ── Mail delivery (SMTP transport) ───────────────────────────────────────────
# Unset = outbox-only mode: invitations stay QUEUED in the admin console and
# nothing is silently dropped — fine for demos and air-gapped installs.
# Set to deliver for real. Grammar:
#   smtp://user:pass@host:587     STARTTLS when offered (opportunistic)
#   smtps://user:pass@host:465    implicit TLS
#   append ?tls=off to disable STARTTLS (local test relays only)
# Retries with backoff are automatic (5 attempts), driven by the worker below.
#SMTP_URL="smtp://user:pass@relay.example.com:587"

# ── Background worker (mail + webhook retries, 30s cadence) ──────────────────
# Runs in-process by default (single-node topology). Set to "off" when the
# passes run externally, or on all-but-one replica of a scaled-out tier.
#DOCURAMA_WORKER="off"

# ── Transparency registry: Sigstore Rekor witnessing of the portal key ──
# Neutral third-party anchoring of the TOFU key pin; free, no account.
# Base URL of the log (default: the public instance; self-hosters can point
# at a private Rekor). Witnessing is lazy (first checkpoint after boot),
# rate-limited, and degrades silently when the log is unreachable.
#REKOR_API_URL="https://rekor.sigstore.dev"
# Set to "off" to disable witnessing entirely (firewalled / air-gapped).
#REKOR_WITNESS="off"

# ── RFC 3161 seal timestamps (src/lib/tsa.ts) ──
# Every seal is timestamped by the workspace TSA (Settings > eSign) or, by
# default, the platform TSA set in Admin > Settings. SEAL_TSA_URL overrides
# the platform TSA; "off" disables timestamping (air-gapped installs).
# DigiCert and GlobalSign answer RFC 3161 over plain HTTP only.
#SEAL_TSA_URL="http://timestamp.digicert.com"
#SEAL_TIMESTAMPS="off"

# ── Seal keys at rest (src/lib/key-vault.ts) ──
# 32 random bytes (openssl rand -hex 32). Encrypts the private keys of seal
# certificates (issued here or imported as .p12). Required to import a
# CA-issued seal certificate. Keep it outside the database and back it up.
#DOCURAMA_KEY_ENCRYPTION_KEY=""
# Public verification page printed (with a QR code) on every sealed PDF.
# Default: https://verify.<ROOT_DOMAIN>/
#PUBLIC_VERIFY_URL="https://verify.docurama.eu/"

# Set to "1" if `next build` fails fetching next/font/google over TLS.
# Uses the OS certificate store instead of Turbopack's bundled roots.
# NEXT_TURBOPACK_EXPERIMENTAL_USE_SYSTEM_TLS_CERTS="1"

# ── Payment provider (billing rails) ─────────────────────────────────────────
# "stripe" (with STRIPE_SECRET_KEY) enables Stripe Checkout, the customer
# portal and webhook-driven renewals. Anything else = manual bank-transfer
# mode: tenants request activation, admins approve in the admin console
# (Billing section). Manual is the default and the self-host path — no
# external dependency. See docs/PAYMENTS.md.
#PAYMENT_PROVIDER="manual"
# Prefer a restricted key (rk_live_…) — permissions listed in docs/PAYMENTS.md.
#STRIPE_SECRET_KEY="rk_live_…"
# Webhook signing secret for POST /api/billing/webhook. Create the endpoint
# with `bun scripts/stripe-setup.ts --webhook-url https://app.<root>/api/billing/webhook`
# (prints the secret once) or in the dashboard with the event list in
# docs/PAYMENTS.md. Stripe mode REFUSES checkouts while this is unset.
#STRIPE_WEBHOOK_SECRET="whsec_…"
# Stripe Tax on Checkout (VAT/OSS). Activate Stripe Tax in the dashboard
# (head office + registrations) BEFORE setting this, or checkouts fail.
#STRIPE_AUTOMATIC_TAX="true"
# Catalog prices exclude VAT (B2B, matches "Prices exclude VAT" on /pricing).
#STRIPE_TAX_BEHAVIOR="exclusive"
# Stripe mode pauses new envelopes for unpaid workspaces (Solo trial over,
# Starter/Business never paid, canceled term over, PAST_DUE beyond the grace).
#BILLING_GRACE_DAYS="14"
#BILLING_ENFORCEMENT="off"
# Test seam: point the Stripe SDK at a local stub (never set in production).
#STRIPE_API_BASE="http://127.0.0.1:9999"

# ── Bot protection (public forms: signup + enterprise lead) ─────────────────
# Honeypot + time trap are always on (the time trap is skipped when
# NEXT_PUBLIC_DEMO_MODE=true so scripted flows can drive the forms).
# Setting TURNSTILE_SECRET_KEY additionally requires a Cloudflare Turnstile
# token on every public form submission (fail-closed). Expose the site key
# to the browser and render the widget, or leave both unset.
#TURNSTILE_SECRET_KEY=""
#NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ── Single sign-on ───────────────────────────────────────────────────────────
# HMAC secret for the SSO transaction cookie (state + PKCE verifier + nonce).
# Set a long random value in production — every instance of a clustered
# deployment must share it. SSO is unavailable without a dedicated secret.
#SSO_TXN_SECRET=""

# Dedicated deployments deny uninvited signup and allow only one tenant.
#DOCURAMA_DEPLOYMENT_MODE="cloud"
#DOCURAMA_PUBLIC_REGISTRATION="true"
