# Docurama Environment Configuration
#
# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
# Every variable below is read directly by backend/app/core/config.py or docker-compose.yml.
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL. Used for signing links, mobile hand-off QR codes and the
# verification portal address printed on the certificate of completion.
DOCURAMA_APP_URL=https://docurama.example.com

# Deployment mode: selfhost (default) keeps public registration closed unless
# DOCURAMA_PUBLIC_REGISTRATION=true; cloud opens registration for the SaaS platform.
DOCURAMA_DEPLOYMENT_MODE=selfhost
DOCURAMA_PUBLIC_REGISTRATION=false

# Cloud platform domain. In cloud mode, tenant workspaces are served at
# <subdomain>.<cloud domain> and verified custom domains. Leave the default on
# self-host; it is inert there.
DOCURAMA_CLOUD_DOMAIN=docurama.eu

# Grant the deployment-wide administrator flag (default mail server, platform
# settings) to a user. Run inside the API container:
#   python scripts/grant_platform_admin.py ops@example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Consumed by the postgres container.
POSTGRES_USER=docurama
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=docurama

# Consumed by the API. Must match the three values above.
DOCURAMA_DATABASE_URL=postgresql+asyncpg://docurama:change_this_to_a_secure_password@docurama-db:5432/docurama
# Synchronous URL used by Alembic migrations.
DOCURAMA_SYNC_DATABASE_URL=postgresql://docurama:change_this_to_a_secure_password@docurama-db:5432/docurama

# ---------------------------------------------------------------------------
# Security & Sessions
# ---------------------------------------------------------------------------
# JWT signing key. The application refuses to start in production if this is
# left at the built-in development default.
DOCURAMA_SECRET_KEY=generate_a_random_secret_string_for_production

# Set to false only for local http development, where a Secure cookie is never stored.
DOCURAMA_COOKIE_SECURE=true

# Environment name. Anything other than "development" enables production guards.
DOCURAMA_ENV=production

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DOCURAMA_STORAGE_DIR=/app/storage

# ---------------------------------------------------------------------------
# Cryptographic Signing (PAdES / RFC 3161)
# ---------------------------------------------------------------------------
# PKCS#12 document signing certificate. The file itself is git-ignored.
DOCURAMA_P12_PATH=/app/certs/docurama_document_signing_cert.p12
DOCURAMA_P12_PASSWORD=change_this_to_your_p12_password
DOCURAMA_ROOT_CA_PATH=/app/certs/docurama_root_ca.crt

# RFC 3161 Timestamp Authority.
DOCURAMA_TSA_URL=http://timestamp.digicert.com

# ---------------------------------------------------------------------------
# Outbound Email
# ---------------------------------------------------------------------------
# Not configured here. The mail server is set in the product: Settings, Notifications,
# Email Delivery. A platform administrator sets the deployment-wide default, and any
# company can override it to send from its own domain. Passwords are encrypted with a
# key derived from DOCURAMA_SECRET_KEY, so rotating that key requires re-entering them.

# ---------------------------------------------------------------------------
# Automatic Reminders
# ---------------------------------------------------------------------------
DOCURAMA_REMINDERS_ENABLED=true
DOCURAMA_REMINDER_SWEEP_MINUTES=60
DOCURAMA_REMINDER_INTERVAL_DAYS=3
DOCURAMA_REMINDER_MAX_COUNT=3

# ---------------------------------------------------------------------------
# Reverse Proxy
# ---------------------------------------------------------------------------
# Trusted proxy addresses for X-Forwarded-For. Required for correct audit IPs.
# Use the Docker bridge range, or "*" when the API port is not published to the host.
FORWARDED_ALLOW_IPS=*

# ---------------------------------------------------------------------------
# Sprint 3 — Cloud launch (all values below are operator-managed; they ship
# empty and every dependent surface answers honest 503s until configured)
# ---------------------------------------------------------------------------
# Stripe billing: flip DOCURAMA_BILLING_ENABLED=true only once the secret key,
# the webhook secret and the three price IDs are in place. Until then the plan
# catalog renders "coming soon" and checkout/portal/cancel return 503.
DOCURAMA_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# Cross-replica WebSocket fan-out. Leave empty for single-replica/self-host
# (in-memory bus). Example: redis://redis:6379/0
DOCURAMA_REDIS_URL=

# Document storage backend: local (default) or s3 (needs DOCURAMA_S3_BUCKET
# plus standard AWS credentials; objects stay private, reads go through
# short-lived presigned URLs).
DOCURAMA_STORAGE_BACKEND=local
DOCURAMA_S3_BUCKET=

# RFC 9116 security.txt contact; derived from APP_URL when left empty.
DOCURAMA_SECURITY_CONTACT=

# Neutral age statement at registration (true by default; switch off where the
# statement itself is inappropriate for the deployment's audience).
DOCURAMA_AGE_GATE_REQUIRED=true

# TLS wildcard automation (deploy/tls_wildcard.sh): the base domain plus the
# DNS provider token for lego (e.g. CLOUDFLARE_DNS_API_TOKEN). Never commit it.
DOCURAMA_TLS_DOMAIN=

# At-rest encryption for stored documents (AES-256-GCM at the storage layer).
# Empty disables it (documents stay plaintext on the backend; volume encryption
# then remains your control). Accepts hex, base64 or 32 raw bytes. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotating: bump DOCURAMA_STORAGE_ENCRYPTION_KEY_ID and move the old material
# into DOCURAMA_STORAGE_ENCRYPTION_KEY_PREVIOUS ("0:<hex>,2:<hex>") — old keys
# stay decrypt-only, new writes go out under the new key.
DOCURAMA_STORAGE_ENCRYPTION_KEY=
DOCURAMA_STORAGE_ENCRYPTION_KEY_ID=1
DOCURAMA_STORAGE_ENCRYPTION_KEY_PREVIOUS=
